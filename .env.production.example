APP_NAME=ScoopPOS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
FORCE_HTTPS=true

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=scoop_pos
DB_USERNAME=replace-with-production-user
DB_PASSWORD=replace-with-production-secret

# Set only the exact HTTPS browser origins that need API access.
CORS_ALLOWED_ORIGINS=https://app.example.com
LOGIN_RATE_LIMIT=5

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
